#version 450

/* Phase 15.3 bloom — upsample pass.
 *
 * 16x16 workgroups. Each dispatch reads the smaller mip and additively blends
 * a 9-tap tent filter into the next-larger mip of the bloom pyramid. The
 * blend factor (spread) controls how tight the glow is. Walking the chain
 * from the smallest mip back up to mip 0 spreads the bright signal outward,
 * producing the soft bloom halo. */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/* The smaller source mip (combined image sampler via a per-mip view). */
layout(set = 0, binding = 0) uniform sampler2D u_source;

/* The larger destination mip (storage image, per-mip view). */
layout(set = 0, binding = 1, rgba16f) uniform image2D u_dest;

/* Must match pb_bloom_push in bloom_pass.c (and bloom_downsample.comp). */
layout(push_constant) uniform BloomUp {
    vec2 texel_size;   /* 1.0 / source (smaller) mip dimensions */
    float threshold;   /* downsample only; unused here, kept for layout parity */
    float spread;      /* blend factor 0..1, default 0.65 */
    uint source_mip;   /* which mip of u_source to read */
} params;

void main()
{
    ivec2 dest_size = imageSize(u_dest);
    if (gl_GlobalInvocationID.x >= uint(dest_size.x) || gl_GlobalInvocationID.y >= uint(dest_size.y)) {
        return;
    }

    /* Map this destination pixel into the smaller source mip's UV space. */
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / vec2(dest_size);
    float lod = float(params.source_mip);

    /* 9-tap tent filter: center (weight 4), cardinals (weight 2), diagonals
     * (weight 1), normalized to 16. */
    vec2 ts = params.texel_size;
    vec3 sum = vec3(0.0);
    float w = 0.0;

    /* 3x3 grid of taps */
    const float weights[3][3] = {
        { 1.0, 2.0, 1.0 },
        { 2.0, 4.0, 2.0 },
        { 1.0, 2.0, 1.0 },
    };
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 off = vec2(float(x), float(y)) * ts;
            float wi = weights[y + 1][x + 1];
            sum += textureLod(u_source, uv + off, lod).rgb * wi;
            w += wi;
        }
    }
    vec3 color = sum / w;

    /* Write (replace, not add) into the destination mip. The destination was
     * written by the downsample pass (mips 1..N-1) or is UNDEFINED (mip 0);
     * we replace its content with the upsampled smaller mip so the bloom
     * pyramid converges to a clean halo rather than accumulating garbage. The
     * spread factor scales the contribution. */
    imageStore(u_dest, ivec2(gl_GlobalInvocationID.xy), vec4(color * params.spread, 1.0));
}
